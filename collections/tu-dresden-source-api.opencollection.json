{
  "opencollection": "1.0.0",
  "info": {
    "name": "LOD authority_search source API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "source",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "getSourceRecord",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://data.slub-dresden.de/source/:source_index/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The ID-String of the entity to access."
              },
              {
                "name": "source_index",
                "value": "",
                "type": "path",
                "description": "The name of the source-index to access the source-data. Allowed Values: ['kxp-de14', 'swb-aut', 'gnd_marc21']"
              }
            ]
          }
        }
      ]
    }
  ],
  "bundled": true
}